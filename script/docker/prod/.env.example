# 生产 compose 用的环境变量模板：复制为 .env 后填写，.env 不进版本库。
#
# 用法（WSL 内）：
#   cd /docker/prod
#   cp .env.example .env && vi .env
#   docker compose --env-file .env up -d heron-server1 nginx-web
#
# 注意：compose 的变量插值对整个文件生效。即使不启动 minio，
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 也必须提供，否则整份 compose 都会报
# "required variable ... is missing a value" 而无法解析。

# MySQL / Redis / 应用共用的库口令
HERON_PASSWORD=

# JWT 签名密钥。泄露了就等于谁都能伪造 admin 的登录令牌，不要用示例值。
# 多实例（server1/server2）必须填同一个值，否则跨实例的令牌互相不认。
# 换这个值会让所有已登录的会话失效。
SA_TOKEN_JWT_SECRET=

# MinIO 管理后台账号（最小 8 位密码）。生产 OSS 当前走七牛云，minio 容器默认不启动，
# 但变量仍须给出以通过 compose 插值。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
