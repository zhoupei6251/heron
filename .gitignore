######################################################################
# Heron 产物与 Axure 素材
# 产物目录只跟仓库根（data-root: ./data）；素材是商业软件产物，不进仓库
# data/ 下只放行三类可复现资产：模板、共用字体与音效/BGM，换机器 clone 后无需另外下载
/data/*
!/data/templates/
!/data/fonts/
!/data/audio/
# 知识包是固定 commit 下的素材与结构化条目，引用要能重放，必须进仓库
!/data/knowledge/
# data/tools 只放行 node 依赖清单；node_modules 与第三方工具靠 npm ci / 单独安装还原
!/data/tools/
/data/tools/*
!/data/tools/package.json
!/data/tools/package-lock.json
!/data/tools/model-stub.mjs
# 模板生成器是模板的唯一真相，必须进仓库：漏了它，clone 下来只剩生成产物，
# 改 template.config.json 也不会生效
!/data/tools/build-templates.mjs
# 模板里的 hyperframes 检查产物是生成的，不进仓库
/data/templates/**/.hyperframes/
*.rp
*.rplib

# AgentScope 运行时会话记录：默认写在工作目录下，不进仓库
.agentscope/

# AI 工具本机挂载（junction 指向 harness-factory 与前端仓库，不提交）
.agents/

# 本地验收启动脚本带真实模型密钥，只留在本机
/run-acceptance-8086.sh
.dsh/
.qoder/
.codebuddy/
.workbuddy/
.openidea/
.ai-runtime-artifacts/
harness-factory
harness.json
.claude/skills/
.claude/launch.json
.claude/agents/frontend-*.md

# 原型与设计产物：仅本机留存，不进仓库
axure/
docs/design/

# 样片 mp4 只留本机：三条 45 秒 1080×1920 加起来 60MB+，
# 进仓库会拖垮 clone。分镜图（storyboard-*.png）留在仓库里作为质量证据。
docs/samples/*.mp4

# 手动渲染用的暂存目录（模板目录不含字体，stage 时注入共用字体）
data/.stage/

# 真实样片验收的产物（成片、联络表、机器证据）：体积大且不进版本库
docs/acceptance-*/
