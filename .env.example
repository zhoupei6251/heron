# 复制成 .env 再填四条（POSTGRES_PASSWORD / DATABASE_URL / REDIS_PASSWORD / HERON_JWT_SECRET）
# 就能跑本机 api。只想跑 Postgres 一条线时，REDIS_PASSWORD 与 REDIS_URL 可以都不填。
# 加载点在 packages/db/src/home.ts（api 与 worker 共用同一份路径计算）。
# 真环境变量优先于本文件：生产与容器由环境注入，本地开发才读 .env。
# .env 不进镜像（.dockerignore 排除），也不进 git——口令只活在这一份文件里。

# 数据落盘位置：成片与诊断产物在这下面（默认 <仓库>/data）。业务数据在 Postgres 里。
# 挪到仓库外就不可能被 git 带出去，正式跑建议改这里。
# 相对值不可用：它按进程工作目录解析，api 与 worker 从不同终端启动会落到两处。
# 容器里由 compose 注入成 /data（挂命名卷），这里的值只作用于宿主进程。
HERON_HOME=D:\absolute\path\to\data

# api 监听端口。默认绑 127.0.0.1；容器里由 compose 注入 HOST=0.0.0.0，
# 因为容器内绑回环时宿主的端口映射会收到空响应（healthcheck 仍然是绿的）。
PORT=3000

# ── Postgres（多租户数据面）──────────────────────────────
# api 与 worker 都真读 DATABASE_URL：身份、任务、闸门、发布全在 Postgres 里。
# compose 与宿主进程读同一份 .env，所以两边不可能连到两个库——T10 搬数据时这点是前提。
# worker 自己不迁移：它等 api 把 schema 建出来（waitForSchema），所以 DATABASE_URL 必填。
POSTGRES_USER=heron
# 留空是故意的：compose 用 ${POSTGRES_PASSWORD:?} 兜住，没填就拒绝起，不带默认口令。
POSTGRES_PASSWORD=
POSTGRES_DB=heron

# 宿主直连容器里的库用（容器内部走 db:5432，读不到这一行）。
# 口令含 @ : / ? 等保留字符时要先百分号编码，postgres.js 按 RFC 3986 解析，不替你转义。
DATABASE_URL=postgres://heron:填成上面的口令@127.0.0.1:5432/heron

# ── Redis（可选第二存储：任务派发队列 + 登录失败计数）────────
# 队列只递 taskId：状态机、租约、尝试次数与闸痕全在 Postgres 的 tasks 表，
# 所以 Redis 挂了业务照样能跑——worker 退回按轮询领活（60s 一轮），只是慢一点。
# REDIS_URL 留空 = 队列与限流都关闭，api 与 worker 照常启动（开源自托管要能只靠 Postgres 跑完整条流水线）；
# 走 deploy/docker-compose.yml 时它默认开着，compose 内部用服务名 redis:6379。
# 口令同样不带默认值：compose 用 ${REDIS_PASSWORD:?} 兜住，没填就拒绝起。
REDIS_PASSWORD=
# 宿主直连用；容器里由 compose 覆盖成 redis://:<口令>@redis:6379。
# 保留字符（@ : / ?）要先百分号编码，理由同 DATABASE_URL。
REDIS_URL=redis://:填成上面的口令@127.0.0.1:6379

# ── 写稿模型（worker 用；api 不读）──────────────────────────
# 单一 OpenAI 兼容 client：换供应商改这三行或改页面配置，不碰代码。
# 页面（工作空间设置 → 写稿模型）里按租户配的优先；这里只是兜底，缺哪项补哪项。
# 默认地址就是七牛云：模型名去「AI 大模型广场」复制完整 id（每个免费模型 id 不同，代码里不给默认值）。
# 模型名留空时 worker 照常启动，只有走到写稿那一步才报「未配置模型名」。
HERON_MODEL_BASE_URL=https://api.qnaigc.com/v1
# 云厂商必填；本机 Ollama / LM Studio 这类回环地址才可以留空。
HERON_MODEL_API_KEY=
HERON_MODEL_NAME=

# ── 镜像来源（只有走 compose 部署时相关）─────────────────────
# 留空 = compose 按本地 build 起（tag heron:local）。接上阿里云 ACR 就填仓库地址：
#   HERON_IMAGE=registry.cn-shanghai.aliyuncs.com/heron-docker/heron:latest
# 是连字符 heron-docker，控制台弹窗显示的下划线 heron_docker 拉不到。
# 填了之后 deploy/pull-latest.sh 才有东西可拉（它认不出 heron:local 就直接跳过这轮）。
HERON_IMAGE=

# ── 会话（计划 T6：cookie 里的 JWT）───────────────────────
# 签名密钥。没有默认值，也没法自动生成——没配或短于 32 字符，api 直接拒绝启动。
# 这不是保守，是「默认密钥 = 任何人都能给自己签一张 owner 的 token」。
# 生成一条（跨平台，Windows 上没有 openssl 也能跑）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 换掉它的时机：泄露过、离职的人知道过、或你想让所有已登录的人重新登录时。
HERON_JWT_SECRET=

# cookie 要不要带 Secure。只认 0 / 1，其它写法启动就炸（猜错方向 = 会话走明文）。
# 本机 http://127.0.0.1 保持 0（设成 1 谁都登不进来）；挂上 TLS/nginx 对外提供服务时改 1。
HERON_COOKIE_SECURE=0

# ── 第一个账号（只被 pnpm db:seed-owner 读，跑完就可以删掉这三行）──
# 全局守卫一上，没有任何账号的 api 谁也进不来，所以建第一个 owner 必须由人显式发起。
# 口令不给默认值也不回显；HERON_OWNER_EMAIL 已存在时脚本只报告、不改口令。
HERON_TENANT_SLUG=default
HERON_OWNER_EMAIL=
HERON_OWNER_PASSWORD=

# 独立平台管理员：仅显式运行 pnpm db:seed-platform 时读取，不随 API 启动创建。
# 用户名可空（默认内置的 admin）；口令必填且为 10–128 位；NAME 可空（默认“平台管理员”）。
# 已存在账号绝不改动。租户 owner 不等于平台管理员；运行后移除这些引导凭据。
HERON_PLATFORM_USERNAME=
HERON_PLATFORM_PASSWORD=
HERON_PLATFORM_NAME=
